    "validate:markdown": "node scripts/validate-markdown-layer.js",
    "validate:vercel": "node scripts/validate-vercel-project.js",
    "validate:domain": "node scripts/validate-domain-alignment.js",
    "validate:release": "npm run validate:instructions && npm run validate:seo && npm run validate:localization && npm run validate:analytics && npm run validate:agent-readiness && npm run test:mcp-readonly && npm run test:agent-concierge && npm run test:agent-observability && npm run validate:markdown && npm run validate:vercel",
