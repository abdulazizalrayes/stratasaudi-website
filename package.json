    "test:private-email-connector": "node scripts/test-private-email-connector.js",
    "smoke:contact-intake": "node scripts/smoke-contact-intake.js",
    "recover:premium-agents": "node scripts/recover-premium-agents.js",
    "submit:indexnow": "node scripts/submit-indexnow.js",
    "enrich:contact": "node scripts/contact_enrichment.js --input ops/crm/enrichment_seed_input.json",
